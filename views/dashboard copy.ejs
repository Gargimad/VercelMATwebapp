<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - JCHS Mu Alpha Theta</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f1f5f9;
            color: #1e293b;
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar Styling */
        .sidebar {
            width: 240px;
            background-color: #1b263b;
            color: white;
            display: flex;
            flex-direction: column;
            padding: 20px 0;
            box-sizing: border-box;
            flex-shrink: 0;
        }
        .sidebar-brand {
            font-size: 18px;
            font-weight: bold;
            padding: 0 20px 25px 20px;
            color: #ffffff;
        }
        .sidebar-menu {
            list-style: none;
            padding: 0;
            margin: 0;
            flex-grow: 1;
        }
        .sidebar-item {
            margin-bottom: 5px;
            padding: 0 10px;
        }
        .sidebar-link {
            display: block;
            padding: 10px 15px;
            color: #94a3b8;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }
        .sidebar-link:hover, .sidebar-link.active {
            background-color: #334155;
            color: #ffffff;
        }
        .sidebar-footer {
            border-top: 1px solid #334155;
            padding: 15px 20px 0 20px;
            font-size: 13px;
            color: #94a3b8;
        }

        /* Main Wrapper & Top Header */
        .main-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }

        .navbar {
            background-color: #0080ff;
            color: white;
            padding: 12px 30px;
            display: flex;
            justify-content: flex-end;
            align-items: center;
        }
        .user-badge {
            background-color: rgba(255, 255, 255, 0.25);
            padding: 4px 12px;
            border-radius: 15px;
            font-size: 13px;
            font-weight: 600;
        }

        /* Content Area */
        .tab-content {
            display: none;
            padding: 30px 40px;
        }
        .tab-content.active {
            display: block;
        }

        .welcome-title {
            font-size: 38px;
            font-weight: bold;
            margin-top: 0;
            margin-bottom: 25px;
            color: #0f172a;
        }

        /* Dashboard Grid Layout */
        .dashboard-grid {
            display: grid;
            grid-template-columns: 1.8fr 1.2fr;
            gap: 25px;
        }

        /* Cards */
        .card-outlined {
            background: #ffffff;
            border: 2px solid #0080ff;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 25px;
            min-height: 180px;
        }
        .card-outlined h3 {
            margin: 0 0 15px 0;
            text-align: center;
            font-size: 20px;
            color: #0f172a;
        }

        .card-filled {
            background-color: #93c5fd;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 25px;
            box-sizing: border-box;
        }

        /* Hours Banner */
        .hours-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }
        .hours-text {
            color: #880000;
            font-size: 20px;
            font-weight: bold;
            line-height: 1.2;
            max-width: 180px;
        }
        .hours-number {
            color: #880000;
            font-size: 48px;
            font-weight: bold;
        }

        /* Action Buttons */
        .btn-group {
            display: flex;
            gap: 10px;
        }
        .btn-dark-red {
            flex: 1;
            background-color: #a00000;
            color: white;
            border: none;
            padding: 10px;
            border-radius: 8px;
            font-weight: bold;
            font-size: 13px;
            cursor: pointer;
            text-align: center;
            transition: background 0.2s;
        }
        .btn-dark-red:hover {
            background-color: #7a0000;
        }

        /* Dynamic Peer List */
        .tutee-list-title {
            text-align: center;
            font-weight: bold;
            font-size: 18px;
            margin-bottom: 15px;
            color: #0f172a;
        }
        .tutee-list {
            list-style-type: disc;
            padding-left: 20px;
            margin: 0;
            font-weight: bold;
            font-size: 16px;
            line-height: 1.8;
            color: #0f172a;
        }

        /* Session Item */
        .session-item {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid #e2e8f0;
        }
        .session-item:last-child {
            border-bottom: none;
        }

        /* Dialog Modal */
        dialog {
            border: none;
            border-radius: 8px;
            padding: 20px;
            width: 90%;
            max-width: 400px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
        }
        dialog::backdrop { background: rgba(0, 0, 0, 0.5); }
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; margin-bottom: 5px; font-size: 14px; }
        .form-group input { width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px; }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-brand">JCHS Mu Alpha Theta</div>
        <ul class="sidebar-menu">
            <li class="sidebar-item"><a class="sidebar-link active" onclick="switchTab('dashboard-tab', this)">Dashboard</a></li>
            <li class="sidebar-item"><a class="sidebar-link" onclick="switchTab('schedule-tab', this)">Schedule Session</a></li>
            <li class="sidebar-item"><a class="sidebar-link" onclick="switchTab('proposed-tab', this)">Proposed Sessions</a></li>
            <li class="sidebar-item"><a class="sidebar-link" onclick="switchTab('upcoming-tab', this)">Upcoming Sessions</a></li>
            <li class="sidebar-item"><a class="sidebar-link" onclick="switchTab('past-tab', this)">Past Sessions</a></li>
            <li class="sidebar-item"><a class="sidebar-link" onclick="switchTab('resources-tab', this)">Resources</a></li>
            <li class="sidebar-item"><a class="sidebar-link" onclick="switchTab('resources-tab', this)">Competitions</a></li>
            <li class="sidebar-item"><a class="sidebar-link" onclick="switchTab('settings-tab', this)">Profile Settings</a></li>
        </ul>
        <div class="sidebar-footer">
            Logged in as:<br>
            <strong><%= user.username %></strong>
            <br><br>
            <a href="/logout" style="color: #f87171; text-decoration: none;">Logout</a>
        </div>
    </div>

    <div class="main-wrapper">
        <div class="navbar">
            <div class="user-badge">
                <%= user.username %> | <%= user.role.toUpperCase() %>
            </div>
        </div>

        <div id="dashboard-tab" class="tab-content active">
            <h1 class="welcome-title">Hi <%= user.username %>,</h1>

            <div class="dashboard-grid">
                <div>
                    <div class="card-outlined">
                        <h3>Upcoming Sessions</h3>
                        <div id="session-list">
                            <% if (sessions.length === 0) { %>
                                <p style="color: #64748b; text-align: center;">No upcoming sessions scheduled.</p>
                            <% } else { %>
                                <% sessions.forEach(session => { %>
                                    <div class="session-item">
                                        <div>
                                            <strong><%= session.title %></strong><br>
                                            <span style="font-size: 12px; color: #64748b;">Peer: <%= session.peer_name %></span>
                                        </div>
                                        <div style="text-align: right;">
                                            <span><%= session.datetime %></span><br>
                                            <span style="font-size: 12px; color: #64748b;"><%= session.location %></span>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>

                    <div class="card-outlined">
                        <h3>View Submissions and Resources</h3>
                        <p style="color: #64748b; text-align: center;">Access worksheets, formula sheets, and student submissions.</p>
                    </div>
                </div>

                <div>
                    <div class="card-filled">
                        <div class="hours-container">
                            <div class="hours-text">
                                <%= user.role === 'tutor' ? 'Total Hours' : 'Hours Attended' %>
                            </div>
                            <div class="hours-number">
                                : <%= sessions.length * 1.5 %>
                            </div>
                        </div>
                        <div class="btn-group">
                            <button class="btn-dark-red" onclick="switchTab('resources-tab', document.querySelectorAll('.sidebar-link')[2])">View Session Recording</button>
                            <% if (user.role === 'tutor') { %>
                                <button class="btn-dark-red" onclick="document.getElementById('sessionModal').showModal()">Log Hours</button>
                            <% } %>
                        </div>
                    </div>

                    <div class="card-filled">
                        <div class="tutee-list-title">
                            <%= user.role === 'tutor' ? 'Your Active Tutees' : 'Available Tutors' %>
                        </div>
                        <ul class="tutee-list">
                            <% if (user.role === 'tutor') { %>
                                <% if (tutees.length === 0) { %>
                                    <li style="list-style-type: none;">No assigned tutees yet.</li>
                                <% } else { %>
                                    <% tutees.forEach(tutee => { %>
                                        <li><%= tutee.username %> (<%= tutee.subject %>)</li>
                                    <% }) %>
                                <% } %>
                            <% } else { %>
                                <% if (tutors.length === 0) { %>
                                    <li style="list-style-type: none;">No available tutors found.</li>
                                <% } else { %>
                                    <% tutors.forEach(tutor => { %>
                                        <li><%= tutor.username %> - <%= tutor.subject %></li>
                                    <% }) %>
                                <% } %>
                            <% } %>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div id="sessions-tab" class="tab-content">
            <div class="card-outlined">
                <h3>All Scheduled Sessions</h3>
                <ul>
                    <% if (sessions.length === 0) { %>
                        <li>No recorded sessions.</li>
                    <% } else { %>
                        <% sessions.forEach(s => { %>
                            <li><strong><%= s.title %></strong> with <%= s.peer_name %> at <%= s.location %> (<%= s.datetime %>)</li>
                        <% }) %>
                    <% } %>
                </ul>
            </div>
        </div>

        <div id="resources-tab" class="tab-content">
            <div class="card-outlined">
                <h3>Math Learning Resources</h3>
                <ul>
                    <li><a href="#">Algebra Practice Worksheets</a></li>
                    <li><a href="#">AP Calculus Formula Sheets</a></li>
                    <li><a href="#">Peer Tutoring Guidelines</a></li>
                </ul>
            </div>
        </div>

        <div id="settings-tab" class="tab-content">
            <div class="card-outlined">
                <h3>Profile Settings</h3>
                <p><strong>Name:</strong> <%= user.username %></p>
                <p><strong>Role:</strong> <%= user.role %></p>
                <p><strong>Primary Math Subject:</strong> <%= user.subject %></p>
            </div>
        </div>
    </div>

    <dialog id="sessionModal">
        <h3 style="margin-top: 0;">Log Tutoring Session</h3>
        <form id="createSessionForm">
            <div class="form-group">
                <label>Topic / Title</label>
                <input type="text" id="title" required placeholder="e.g., AP Calc BC Prep">
            </div>
            <div class="form-group">
                <label>Tutee Name</label>
                <input type="text" id="peer_name" required placeholder="e.g., Brian Houston">
            </div>
            <div class="form-group">
                <label>Date & Time</label>
                <input type="text" id="datetime" required placeholder="e.g., Today, 3:30 PM">
            </div>
            <div class="form-group">
                <label>Location</label>
                <input type="text" id="location" required placeholder="e.g., Room 214">
            </div>
            <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 15px;">
                <button type="button" class="btn-dark-red" style="background: #cbd5e1; color: #333;" onclick="document.getElementById('sessionModal').close()">Cancel</button>
                <button type="submit" class="btn-dark-red">Save Session</button>
            </div>
        </form>
    </dialog>

    <script>
        function switchTab(tabId, element) {
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
            document.querySelectorAll('.sidebar-link').forEach(link => link.classList.remove('active'));
            
            document.getElementById(tabId).classList.add('active');
            if (element) element.classList.add('active');
        }

        document.getElementById('createSessionForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const urlParams = new URLSearchParams(window.location.search);
            const userId = urlParams.get('id');

            const payload = {
                title: document.getElementById('title').value,
                peer_name: document.getElementById('peer_name').value,
                datetime: document.getElementById('datetime').value,
                location: document.getElementById('location').value,
                userId: userId
            };

            const response = await fetch('/api/sessions', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });

            if (response.ok) {
                window.location.reload();
            }
        });
    </script>
</body>
</html>