<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - JCHS Mu Alpha Theta</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include('partials/sidebar') %>

    <div class="main-wrapper">
        <%- include('partials/navbar') %>

        <div id="dashboard-tab" class="tab-content active">
            <h1 class="welcome-title">Hi <%= user.username %>,</h1>

            <div class="square-cards-container">
                <div class="card-square">
                    <button class="card-button" style="background-color: #550000;" onclick="switchTab('proposed-tab', null); loadProposedSessions();">
                        View proposed sessions
                    </button>
                </div>

                <div class="card-square">
                    <button class="card-button" style="background-color: #550000;" onclick="switchTab('upcoming-tab', null); loadUpcomingSessions();">
                        View upcoming sessions
                    </button>
                </div>

                <div class="card-square">
                    <button class="card-button" style="background-color: #550000;" onclick="switchTab('past-sessions-tab', null); loadPastSessions();">
                        Past Sessions
                    </button>
                </div>

                <% if (user.role === 'tutor') { %>
                    <div class="card-square">
                        <button class="card-button" style="background-color: #550000;" onclick="switchTab('volunteer-hours-tab', null); loadVolunteerHours();">
                            Volunteer Hours
                        </button>
                    </div>
                <% } %>

                <div class="card-square">
                    <button class="card-button" style="background-color: #550000;" onclick="switchTab('schedule-tab', null)">
                        Schedule Sessions
                    </button>
                </div>

                <div class="card-square">
                    <button class="card-button" style="background-color: #550000;" onclick="switchTab('settings-tab', null)">
                        Settings
                    </button>
                </div>
            </div>
        </div>

        <div id="schedule-tab" class="tab-content">
            <div class="card-outlined" style="max-width: 700px; margin: 0 auto;">
                <%- include('partials/step1') %>
                <%- include('partials/step2') %>
                <%- include('partials/step3') %>
            </div>
        </div>

        <div id="proposed-tab" class="tab-content">
            <div class="card-outlined">
                <h3>Proposed Sessions</h3>
                <div id="proposed-sessions-list">
                    <p style="color: #64748b;">No proposed sessions at this time.</p>
                </div>
            </div>
        </div>

        <div id="upcoming-tab" class="tab-content">
            <div class="card-outlined">
                <h3>Upcoming Sessions</h3>
                <div id="upcoming-sessions-list">
                    <p style="color: #64748b;">No upcoming sessions scheduled.</p>
                </div>
            </div>
        </div>

        <div id="past-sessions-tab" class="tab-content">
            <div class="card-outlined">
                <h3>Past Sessions</h3>
                <p style="color: #64748b; font-size: 14px;">History of all your completed tutoring sessions.</p>
                <div id="past-sessions-container">
                    <p style="color: #64748b;">Loading past sessions...</p>
                </div>
            </div>
        </div>

        <% if (user.role === 'tutor') { %>
            <div id="volunteer-hours-tab" class="tab-content">
                <div class="card-outlined">
                    <h3>Volunteer Hours</h3>
                    <div class="hours-badge">
                        <div style="font-size: 14px; opacity: 0.9;">Total Logged Volunteer Hours</div>
                        <div id="total-volunteer-hours" style="font-size: 32px; font-weight: bold;">0.0 hrs</div>
                    </div>

                    <h4>Completed Hours Log</h4>
                    <div id="volunteer-log-container">
                        <p style="color: #64748b;">Loading hours log...</p>
                    </div>
                </div>
            </div>
        <% } %>

        <div id="resources-tab" class="tab-content">
            <div class="card-outlined">
                <h3>Math Learning Resources</h3>
                <ul>
                    <li><a href="#">Algebra Practice Worksheets</a></li>
                    <li><a href="#">AP Calculus Formula Sheets</a></li>
                    <li><a href="#">Peer Tutoring Guidelines</a></li>
                </ul>
            </div>
        </div>

        <div id="competitions-tab" class="tab-content">
            <div class="card-outlined">
                <h3>Competitions</h3>
                <p style="color: #64748b;">No upcoming competitions posted yet.</p>
            </div>
        </div>

        <div id="settings-tab" class="tab-content">
            <div class="card-outlined">
                <h3>Profile Settings</h3>
                <p><strong>Name:</strong> <%= user.username %></p>
                <p><strong>Role:</strong> <%= user.role %></p>
                <p><strong>Primary Subject:</strong> <%= user.subject %></p>
            </div>
        </div>
    </div>

    <script>
        const CURRENT_USER_ID = "<%= user.id %>";
        const CURRENT_USER_ROLE = "<%= user.role %>";
    </script>
    <script src="/js/dashboard.js"></script>
</body>
</html>

