<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Portal - TutorConnect</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

<div class="container">
    <!-- Header -->
    <div class="header">
        <div class="header-left">
            <div class="brand-icon">TC</div>
            <div>
                <h2>Admin Portal</h2>
                <div class="header-subtitle">TutorConnect Management</div>
            </div>
        </div>
        <a href="/logout" class="logout-btn">← Logout</a>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">
        <div class="stat-card pending">
            <div class="stat-number"><%= users.filter(u => u.status === 'pending').length %></div>
            <div class="stat-label">Pending Approvals</div>
        </div>
        <div class="stat-card active">
            <div class="stat-number"><%= users.filter(u => u.status === 'active').length %></div>
            <div class="stat-label">Active Users</div>
        </div>
        <div class="stat-card tutors">
            <div class="stat-number"><%= users.filter(u => u.role === 'tutor').length %></div>
            <div class="stat-label">Total Tutors</div>
        </div>
        <div class="stat-card total">
            <div class="stat-number"><%= users.length %></div>
            <div class="stat-label">Total Registered</div>
        </div>
    </div>

    <!-- Bulk Actions Bar -->
    <div class="bulk-actions hidden" id="bulkActions">
        <div class="bulk-info">
            <span id="selectedCount">0</span> user(s) selected
        </div>
        <div class="bulk-buttons">
            <button class="bulk-btn bulk-approve" onclick="bulkUpdateStatus('active')">
                ✓ Approve Selected
            </button>
            <button class="bulk-btn bulk-reject" onclick="bulkUpdateStatus('rejected')">
                ✕ Reject Selected
            </button>
        </div>
    </div>

    <!-- Filter Controls -->
    <div class="filter-group">
        <button class="filter-btn active" onclick="filterUsers('all', this)">
            All Users
            <span class="filter-count"><%= users.length %></span>
        </button>
        <button class="filter-btn" onclick="filterUsers('pending', this)">
            Pending
            <span class="filter-count"><%= users.filter(u => u.status === 'pending').length %></span>
        </button>
        <button class="filter-btn" onclick="filterUsers('active', this)">
            Active
            <span class="filter-count"><%= users.filter(u => u.status === 'active').length %></span>
        </button>
        <button class="filter-btn" onclick="filterUsers('rejected', this)">
            Rejected
            <span class="filter-count"><%= users.filter(u => u.status === 'rejected').length %></span>
        </button>
    </div>

    <!-- Users Table -->
    <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>
                        <input type="checkbox" class="select-all-checkbox" onclick="toggleSelectAll(this)" title="Select All">
                    </th>
                    <th>User</th>
                    <th>Role</th>
                    <th>Grade</th>
                    <th>Subject</th>
                    <th>Volunteer Hours</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="userTableBody">
                <% if (users.length === 0) { %>
                    <tr>
                        <td colspan="8">
                            <div class="empty-state">
                                <div class="empty-state-icon">📋</div>
                                <p>No users found in the system.</p>
                            </div>
                        </td>
                    </tr>
                <% } %>
                <% users.forEach(user => { %>
                    <tr class="user-row status-<%= user.status %>" data-user-id="<%= user.id %>" data-status="<%= user.status %>">
                        <td>
                            <div class="checkbox-wrapper">
                                <input type="checkbox" class="user-checkbox" value="<%= user.id %>" onchange="updateBulkActions()">
                            </div>
                        </td>
                        <td>
                            <div class="user-name"><%= user.username %></div>
                            <div class="user-email">ID: <%= user.id.substring(0, 8) %>...</div>
                        </td>
                        <td>
                            <span style="text-transform: capitalize;"><%= user.role %></span>
                            <% if (user.role === 'tutor') { %>
                                <br><span class="badge badge-tutor">Tutor</span>
                            <% } %>
                        </td>
                        <td><%= user.grade ? user.grade + 'th' : 'N/A' %></td>
                        <td><%= user.subject %></td>
                        <td>
                            <% if (user.role === 'tutor') { %>
                                <div class="volunteer-hours" id="hours-<%= user.id %>">
                                    <span>Loading...</span>
                                </div>
                            <% } else { %>
                                <span style="color: #a0aec0;">—</span>
                            <% } %>
                        </td>
                        <td>
                            <span class="badge badge-<%= user.status %>" id="badge-<%= user.id %>">
                                <%= user.status %>
                            </span>
                        </td>
                        <td>
                            <% if (user.status === 'pending') { %>
                                <button class="btn-action btn-approve" onclick="updateUserStatus('<%= user.id %>', 'active')">✓ Approve</button>
                                <button class="btn-action btn-reject" onclick="updateUserStatus('<%= user.id %>', 'rejected')">✕ Reject</button>
                            <% } else if (user.status === 'rejected') { %>
                                <button class="btn-action btn-approve" onclick="updateUserStatus('<%= user.id %>', 'active')">↩ Re-approve</button>
                            <% } %>
                            <button class="btn-action btn-delete" onclick="deleteUser('<%= user.id %>')">🗑 Delete</button>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<script>
    const urlParams = new URLSearchParams(window.location.search);
    const currentAdminId = urlParams.get('id');

    // ===== LOAD VOLUNTEER HOURS FOR TUTORS =====
    async function loadVolunteerHours() {
        const tutorRows = document.querySelectorAll('.user-row');
        
        for (const row of tutorRows) {
            const userId = row.dataset.userId;
            const hoursCell = document.getElementById(`hours-${userId}`);
            
            if (hoursCell) {
                try {
                    const response = await fetch(`/api/volunteer-hours?userId=${userId}`);
                    if (response.ok) {
                        const data = await response.json();
                        hoursCell.innerHTML = `
                            <strong>${data.totalHours}</strong> hrs
                            <br><span>${data.sessions.length} sessions</span>
                        `;
                    } else {
                        hoursCell.innerHTML = '<span style="color: #a0aec0;">0 hrs</span>';
                    }
                } catch (err) {
                    hoursCell.innerHTML = '<span style="color: #a0aec0;">Error</span>';
                }
            }
        }
    }

    // ===== UPDATE SINGLE USER STATUS =====
    async function updateUserStatus(userId, status) {
        const action = status === 'active' ? 'approve' : 'reject';
        if (!confirm(`Are you sure you want to ${action} this user?`)) return;

        try {
            const response = await fetch('/api/users/update-status', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    userId, 
                    status,
                    adminId: currentAdminId 
                })
            });

            const result = await response.json();

            if (response.ok) {
                updateUserRow(userId, status);
                showToast(`User ${action}d successfully!`, 'success');
                updateStatsCounts();
            } else {
                showToast('Error: ' + result.error, 'error');
            }
        } catch (err) {
            console.error('Update status error:', err);
            showToast('Failed to connect to server.', 'error');
        }
    }

    // ===== BULK UPDATE STATUS =====
    async function bulkUpdateStatus(status) {
        const selectedCheckboxes = document.querySelectorAll('.user-checkbox:checked');
        if (selectedCheckboxes.length === 0) {
            showToast('Please select at least one user.', 'error');
            return;
        }

        const action = status === 'active' ? 'approve' : 'reject';
        if (!confirm(`Are you sure you want to ${action} ${selectedCheckboxes.length} user(s)?`)) return;

        let successCount = 0;
        let failCount = 0;

        for (const checkbox of selectedCheckboxes) {
            const userId = checkbox.value;
            try {
                const response = await fetch('/api/users/update-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        userId, 
                        status,
                        adminId: currentAdminId 
                    })
                });

                if (response.ok) {
                    updateUserRow(userId, status);
                    successCount++;
                } else {
                    failCount++;
                }
            } catch (err) {
                failCount++;
            }
        }

        if (successCount > 0) {
            showToast(`${successCount} user(s) ${action}d successfully!`, 'success');
        }
        if (failCount > 0) {
            showToast(`${failCount} user(s) failed to update.`, 'error');
        }

        updateStatsCounts();
        updateBulkActions();
    }

    // ===== DELETE USER =====
    async function deleteUser(userId) {
        if (!confirm("Are you sure you want to permanently delete this user? This cannot be undone.")) return;

        try {
            const response = await fetch('/api/users/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    userId,
                    adminId: currentAdminId
                })
            });

            const result = await response.json();

            if (response.ok) {
                const row = document.querySelector(`tr[data-user-id="${userId}"]`);
                if (row) {
                    row.style.transition = 'all 0.3s ease';
                    row.style.opacity = '0';
                    row.style.transform = 'translateX(20px)';
                    setTimeout(() => row.remove(), 300);
                }
                showToast('User deleted successfully!', 'success');
                updateStatsCounts();
            } else {
                showToast('Error: ' + result.error, 'error');
            }
        } catch (err) {
            console.error('Delete error:', err);
            showToast('Failed to connect to server.', 'error');
        }
    }

    // ===== HELPER: Update User Row UI =====
    function updateUserRow(userId, status) {
        const badge = document.getElementById(`badge-${userId}`);
        if (badge) {
            badge.className = `badge badge-${status}`;
            badge.innerText = status;
        }

        const row = document.querySelector(`tr[data-user-id="${userId}"]`);
        if (row) {
            row.className = `user-row status-${status}`;
            row.dataset.status = status;

            // Update action buttons
            const actionCell = row.querySelector('td:last-child');
            if (status === 'active') {
                actionCell.innerHTML = `
                    <button class="btn-action btn-delete" onclick="deleteUser('${userId}')">🗑 Delete</button>
                `;
            } else if (status === 'rejected') {
                actionCell.innerHTML = `
                    <button class="btn-action btn-approve" onclick="updateUserStatus('${userId}', 'active')">↩ Re-approve</button>
                    <button class="btn-action btn-delete" onclick="deleteUser('${userId}')">🗑 Delete</button>
                `;
            }

            // Uncheck the checkbox
            const checkbox = row.querySelector('.user-checkbox');
            if (checkbox) checkbox.checked = false;
        }
    }

    // ===== BULK SELECTION =====
    function toggleSelectAll(selectAllCheckbox) {
        const checkboxes = document.querySelectorAll('.user-checkbox:not([style*="display: none"])');
        checkboxes.forEach(cb => {
            const row = cb.closest('tr');
            if (row && row.style.display !== 'none') {
                cb.checked = selectAllCheckbox.checked;
            }
        });
        updateBulkActions();
    }

    function updateBulkActions() {
        const selectedCheckboxes = document.querySelectorAll('.user-checkbox:checked');
        const bulkActions = document.getElementById('bulkActions');
        const selectedCount = document.getElementById('selectedCount');
        
        const count = selectedCheckboxes.length;
        
        if (count > 0) {
            bulkActions.classList.remove('hidden');
            selectedCount.textContent = count;
        } else {
            bulkActions.classList.add('hidden');
        }
    }

    // ===== FILTER USERS =====
    function filterUsers(filter, button) {
        document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
        button.classList.add('active');

        const rows = document.querySelectorAll('.user-row');
        rows.forEach(row => {
            if (filter === 'all' || row.dataset.status === filter) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
                const checkbox = row.querySelector('.user-checkbox');
                if (checkbox) checkbox.checked = false;
            }
        });

        // Reset select all
        document.querySelector('.select-all-checkbox').checked = false;
        updateBulkActions();
    }

    // ===== UPDATE STATS =====
    function updateStatsCounts() {
        // Reload page to refresh stats (simple approach)
        // For dynamic update, you could recalculate from visible rows
        setTimeout(() => location.reload(), 1000);
    }

    // ===== TOAST NOTIFICATIONS =====
    function showToast(message, type = 'success') {
        const toast = document.createElement('div');
        toast.className = `toast toast-${type}`;
        toast.textContent = message;
        document.body.appendChild(toast);

        setTimeout(() => {
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(100%)';
            toast.style.transition = 'all 0.3s ease';
            setTimeout(() => toast.remove(), 300);
        }, 3000);
    }

    // ===== INITIALIZE =====
    document.addEventListener('DOMContentLoaded', () => {
        loadVolunteerHours();
    });

    // Update bulk actions when checkboxes change
    document.addEventListener('change', (e) => {
        if (e.target.classList.contains('user-checkbox')) {
            updateBulkActions();
        }
    });
</script>

</body>
</html>