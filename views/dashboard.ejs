<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard - JCHS Math Tutoring</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=DM+Serif+Text:ital@0;1&family=Rowdies:wght@300;400;700&display=swap"
        rel="stylesheet"
    >

    <!-- Dashboard CSS -->
    <link rel="stylesheet" href="/css/dashboard.css">
</head>

<body>

    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <aside class="sidebar">

        <div class="sidebar-logo">
            <img
                src="/images/logo.png"
                alt="JCHS Math Tutoring"
                onerror="this.style.display='none'"
            >

            <div class="sidebar-title">
                <span>JCHS</span>
                <span>Math Tutoring</span>
            </div>
        </div>


        <nav class="sidebar-nav">

            <button
                class="nav-link active"
                data-tab="dashboard-tab"
                type="button"
            >
                <span>⌂</span>
                Dashboard
            </button>


            <% if (profile.role === "tutee") { %>

                <button
                    class="nav-link"
                    data-tab="find-tutor-tab"
                    type="button"
                >
                    <span>⌕</span>
                    Find a Tutor
                </button>

            <% } %>


            <button
                class="nav-link"
                data-tab="requests-tab"
                type="button"
            >
                <span>✉</span>
                Requests
            </button>


            <button
                class="nav-link"
                data-tab="upcoming-tab"
                type="button"
            >
                <span>◷</span>
                Upcoming Sessions
            </button>


            <button
                class="nav-link"
                data-tab="past-tab"
                type="button"
            >
                <span>✓</span>
                Past Sessions
            </button>


            <% if (profile.role === "tutor") { %>

                <button
                    class="nav-link"
                    data-tab="hours-tab"
                    type="button"
                >
                    <span>★</span>
                    Volunteer Hours
                </button>

            <% } %>


            <button
                class="nav-link"
                data-tab="resources-tab"
                type="button"
            >
                <span>▣</span>
                Resources
            </button>


            <button
                class="nav-link"
                data-tab="profile-tab"
                type="button"
            >
                <span>●</span>
                Profile
            </button>

        </nav>


        <div class="sidebar-bottom">

            <a href="/" class="sidebar-home">
                ← Home
            </a>

        </div>

    </aside>



    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main class="dashboard-main">

        <!-- HEADER -->

        <header class="dashboard-header">

            <div>
                <p class="dashboard-eyebrow">
                    JCHS MATH TUTORING
                </p>

                <h1>
                    Welcome,
                    <%= profile.first_name %>!
                </h1>
            </div>


            <div class="header-user">

                <div class="header-user-name">
                    <%= profile.first_name %>
                    <%= profile.last_name %>
                </div>

                <div class="header-user-role">
                    <%= profile.role === "tutor" ? "Tutor" : "Tutee" %>
                </div>

            </div>

        </header>



        <!-- =================================================
             ALERT
        ================================================== -->

        <div
            id="dashboard-alert"
            class="dashboard-alert"
            role="alert"
        ></div>



        <!-- =================================================
             DASHBOARD TAB
        ================================================== -->

        <section
            id="dashboard-tab"
            class="dashboard-tab active"
        >

            <% if (profile.role === "tutee") { %>

                <!-- TUTEE HERO -->

                <div class="dashboard-hero">

                    <div class="hero-content">

                        <p class="eyebrow">
                            FIND YOUR MATH TUTOR
                        </p>

                        <h2>
                            Let's make math<br>
                            make sense.
                        </h2>

                        <p>
                            Choose the subject you're working on
                            and find a JCHS tutor who can help.
                        </p>


                        <div class="subject-search">

                            <label for="subjectSelect">
                                What do you need help with?
                            </label>

                            <select
                                id="subjectSelect"
                                class="form-select"
                            >

                                <option value="">
                                    Select a subject
                                </option>

                                <option value="algebra-1">
                                    Algebra I
                                </option>

                                <option value="geometry">
                                    Geometry
                                </option>

                                <option value="algebra-2">
                                    Algebra II
                                </option>

                                <option value="precalculus">
                                    Precalculus
                                </option>

                                <option value="calculus-ab">
                                    AP Calculus AB
                                </option>

                                <option value="calculus-bc">
                                    AP Calculus BC
                                </option>

                                <option value="statistics">
                                    AP Statistics
                                </option>

                                <option value="other">
                                    Other
                                </option>

                            </select>


                            <div class="hero-actions">

                                <button
                                    type="button"
                                    id="findTutorsBtn"
                                    class="btn-primary"
                                >
                                    Find Tutors
                                </button>

                                <button
                                    type="button"
                                    id="spinForMeBtn"
                                    class="btn-secondary"
                                >
                                    🎲 Spin for Me
                                </button>

                            </div>

                        </div>

                    </div>

                </div>



                <!-- TUTOR RESULTS -->

                <section class="dashboard-section">

                    <div class="section-heading">

                        <div>
                            <p class="eyebrow">
                                MATCHES
                            </p>

                            <h2>
                                Tutors for You
                            </h2>
                        </div>

                    </div>


                    <div
                        id="tutorResults"
                        class="tutor-results"
                    >

                        <div class="empty-state">
                            <p>
                                Select a subject to find tutors.
                            </p>
                        </div>

                    </div>

                </section>



                <!-- RECENT REQUESTS -->

                <section class="dashboard-section">

                    <div class="section-heading">

                        <div>
                            <p class="eyebrow">
                                YOUR REQUESTS
                            </p>

                            <h2>
                                Recent Requests
                            </h2>
                        </div>

                        <button
                            type="button"
                            class="text-button"
                            data-tab="requests-tab"
                        >
                            View all →
                        </button>

                    </div>


                    <div
                        id="tuteeRequests"
                        class="requests-list"
                    >

                        <div class="empty-state">
                            <p>
                                You haven't sent any tutoring requests yet.
                            </p>
                        </div>

                    </div>

                </section>


            <% } else { %>


                <!-- =================================================
                     TUTOR DASHBOARD
                ================================================== -->

                <div class="dashboard-hero tutor-hero">

                    <div class="hero-content">

                        <p class="eyebrow">
                            TUTOR DASHBOARD
                        </p>

                        <h2>
                            Ready to help<br>
                            someone succeed?
                        </h2>

                        <p>
                            Review incoming tutoring requests
                            and connect with students.
                        </p>

                        <button
                            type="button"
                            class="btn-primary"
                            data-tab="requests-tab"
                        >
                            View Requests
                        </button>

                    </div>

                </div>



                <!-- TUTOR REQUESTS -->

                <section class="dashboard-section">

                    <div class="section-heading">

                        <div>
                            <p class="eyebrow">
                                INCOMING
                            </p>

                            <h2>
                                Tutoring Requests
                            </h2>
                        </div>

                    </div>


                    <div
                        id="tutorRequests"
                        class="requests-list"
                    >

                        <div class="empty-state">
                            <p>
                                You don't have any tutoring requests yet.
                            </p>
                        </div>

                    </div>

                </section>

            <% } %>

        </section>



        <!-- =================================================
             FIND TUTOR TAB
        ================================================== -->

        <% if (profile.role === "tutee") { %>

            <section
                id="find-tutor-tab"
                class="dashboard-tab"
            >

                <div class="page-heading">

                    <p class="eyebrow">
                        FIND A TUTOR
                    </p>

                    <h2>
                        Find the right person to help.
                    </h2>

                    <p>
                        Choose a subject to see available JCHS tutors.
                    </p>

                </div>


                <div class="find-tutor-controls">

                    <select
                        id="findTutorSubject"
                        class="form-select"
                    >

                        <option value="">
                            Select a subject
                        </option>

                        <option value="algebra-1">
                            Algebra I
                        </option>

                        <option value="geometry">
                            Geometry
                        </option>

                        <option value="algebra-2">
                            Algebra II
                        </option>

                        <option value="precalculus">
                            Precalculus
                        </option>

                        <option value="calculus-ab">
                            AP Calculus AB
                        </option>

                        <option value="calculus-bc">
                            AP Calculus BC
                        </option>

                        <option value="statistics">
                            AP Statistics
                        </option>

                        <option value="other">
                            Other
                        </option>

                    </select>


                    <button
                        type="button"
                        id="findTutorPageBtn"
                        class="btn-primary"
                    >
                        Find Tutors
                    </button>

                </div>


                <div
                    id="findTutorResults"
                    class="tutor-results"
                ></div>

            </section>

        <% } %>



        <!-- =================================================
             REQUESTS TAB
        ================================================== -->

        <section
            id="requests-tab"
            class="dashboard-tab"
        >

            <div class="page-heading">

                <p class="eyebrow">
                    REQUESTS
                </p>

                <h2>
                    Tutoring Requests
                </h2>

                <p>
                    Manage your tutoring connections here.
                </p>

            </div>


            <div
                id="requestsPage"
                class="requests-list"
            >

                <div class="empty-state">
                    <p>
                        Loading requests...
                    </p>
                </div>

            </div>

        </section>



        <!-- =================================================
             UPCOMING SESSIONS
        ================================================== -->

        <section
            id="upcoming-tab"
            class="dashboard-tab"
        >

            <div class="page-heading">

                <p class="eyebrow">
                    SCHEDULE
                </p>

                <h2>
                    Upcoming Sessions
                </h2>

                <p>
                    Your scheduled tutoring sessions will appear here.
                </p>

            </div>


            <div
                id="upcomingSessions"
                class="sessions-list"
            >

                <div class="empty-state">

                    <p>
                        No upcoming sessions yet.
                    </p>

                </div>

            </div>

        </section>



        <!-- =================================================
             PAST SESSIONS
        ================================================== -->

        <section
            id="past-tab"
            class="dashboard-tab"
        >

            <div class="page-heading">

                <p class="eyebrow">
                    HISTORY
                </p>

                <h2>
                    Past Sessions
                </h2>

                <p>
                    Your completed tutoring sessions will appear here.
                </p>

            </div>


            <div
                id="pastSessions"
                class="sessions-list"
            >

                <div class="empty-state">

                    <p>
                        No past sessions yet.
                    </p>

                </div>

            </div>

        </section>



        <!-- =================================================
             VOLUNTEER HOURS
        ================================================== -->

        <% if (profile.role === "tutor") { %>

            <section
                id="hours-tab"
                class="dashboard-tab"
            >

                <div class="page-heading">

                    <p class="eyebrow">
                        VOLUNTEER HOURS
                    </p>

                    <h2>
                        Your Impact
                    </h2>

                    <p>
                        Keep track of the time you've spent helping other students.
                    </p>

                </div>


                <div class="hours-card">

                    <div class="hours-number">
                        0
                    </div>

                    <div class="hours-label">
                        Volunteer Hours
                    </div>

                </div>

            </section>

        <% } %>



        <!-- =================================================
             RESOURCES
        ================================================== -->

        <section
            id="resources-tab"
            class="dashboard-tab"
        >

            <div class="page-heading">

                <p class="eyebrow">
                    RESOURCES
                </p>

                <h2>
                    Math Resources
                </h2>

                <p>
                    Helpful resources for studying mathematics.
                </p>

            </div>


            <div class="resource-grid">

                <div class="resource-card">

                    <h3>
                        Practice Problems
                    </h3>

                    <p>
                        Build confidence by practicing problems
                        related to your current math course.
                    </p>

                </div>


                <div class="resource-card">

                    <h3>
                        Study Tips
                    </h3>

                    <p>
                        Break difficult concepts into smaller,
                        manageable pieces.
                    </p>

                </div>


                <div class="resource-card">

                    <h3>
                        Ask Your Tutor
                    </h3>

                    <p>
                        Don't be afraid to ask questions.
                        That's what tutoring is for!
                    </p>

                </div>

            </div>

        </section>



        <!-- =================================================
             PROFILE
        ================================================== -->

        <section
            id="profile-tab"
            class="dashboard-tab"
        >

            <div class="page-heading">

                <p class="eyebrow">
                    PROFILE
                </p>

                <h2>
                    Your Profile
                </h2>

            </div>


            <div class="profile-card">

                <div class="profile-row">

                    <span>
                        Name
                    </span>

                    <strong>
                        <%= profile.first_name %>
                        <%= profile.last_name %>
                    </strong>

                </div>


                <div class="profile-row">

                    <span>
                        Student ID
                    </span>

                    <strong>
                        <%= profile.student_id %>
                    </strong>

                </div>


                <div class="profile-row">

                    <span>
                        Role
                    </span>

                    <strong>
                        <%= profile.role === "tutor" ? "Tutor" : "Tutee" %>
                    </strong>

                </div>

            </div>

        </section>

    </main>



    <!-- =====================================================
         REQUEST MODAL
    ====================================================== -->

    <div
        id="requestModal"
        class="request-modal"
        aria-hidden="true"
    >

        <div
            class="request-modal-card"
            role="dialog"
            aria-modal="true"
            aria-labelledby="requestModalTitle"
        >

            <button
                type="button"
                class="request-modal-close"
                onclick="closeRequestModal()"
                aria-label="Close"
            >
                ×
            </button>


            <p class="eyebrow">
                TUTORING REQUEST
            </p>


            <h2 id="requestModalTitle">
                Request help from
                <span id="requestTutorName"></span>
            </h2>


            <p class="request-subject">
                Subject:
                <strong id="requestSubjectName"></strong>
            </p>


            <label
                for="requestNote"
                class="request-note-label"
            >
                Add a note
                <span>(optional)</span>
            </label>


            <textarea
                id="requestNote"
                class="request-note"
                placeholder="Tell your tutor what you'd like help with..."
                maxlength="500"
            ></textarea>


            <p class="request-note-hint">
                A short note can help your tutor understand
                what you need before they accept.
            </p>


            <div class="request-modal-actions">

                <button
                    type="button"
                    class="btn-secondary"
                    onclick="closeRequestModal()"
                >
                    Cancel
                </button>


                <button
                    type="button"
                    id="sendRequestBtn"
                    class="btn-primary"
                    onclick="submitTutorRequest()"
                >
                    Send Request
                </button>

            </div>

        </div>

    </div>



    <!-- =====================================================
         JAVASCRIPT VARIABLES
    ====================================================== -->

    <script>
        const CURRENT_USER_ID = "<%= profile.id %>";
        const CURRENT_USER_ROLE = "<%= profile.role %>";
    </script>

    <script src="/js/dashboard.js"></script>

</body>

</html>