<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - JCHS Mu Alpha Theta</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f1f5f9;
            color: #1e293b;
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 240px;
            background-color: #1b263b;
            color: white;
            display: flex;
            flex-direction: column;
            padding: 20px 0;
            box-sizing: border-box;
            flex-shrink: 0;
        }
        .sidebar-brand {
            font-size: 18px;
            font-weight: bold;
            padding: 0 20px 25px 20px;
            color: #ffffff;
        }
        .sidebar-menu {
            list-style: none;
            padding: 0;
            margin: 0;
            flex-grow: 1;
        }
        .sidebar-item {
            margin-bottom: 5px;
            padding: 0 10px;
        }
        .sidebar-link {
            display: block;
            padding: 10px 15px;
            color: #94a3b8;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
        }
        .sidebar-link:hover, .sidebar-link.active {
            background-color: #334155;
            color: #ffffff;
        }
        .sidebar-footer {
            border-top: 1px solid #334155;
            padding: 15px 20px 0 20px;
            font-size: 13px;
            color: #94a3b8;
        }

        .main-wrapper {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
        }

        .navbar {
            background-color: #0080ff;
            color: white;
            padding: 12px 30px;
            display: flex;
            justify-content: flex-end;
            align-items: center;
        }
        .user-badge {
            background-color: rgba(255, 255, 255, 0.25);
            padding: 4px 12px;
            border-radius: 15px;
            font-size: 13px;
            font-weight: 600;
        }

        .tab-content {
            display: none;
            padding: 30px 40px;
        }
        .tab-content.active {
            display: block;
        }

        .welcome-title {
            font-size: 38px;
            font-weight: bold;
            margin-top: 0;
            margin-bottom: 25px;
            color: #0f172a;
        }

        .square-cards-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .card-square {
            background: #ffffff;
            border: 2px solid #0080ff;
            border-radius: 12px;
            aspect-ratio: 1 / 1;
            display: flex;
            padding: 12px;
            box-sizing: border-box;
        }

        .card-button {
            width: 100%;
            height: 100%;
            background-color: #1b263b;
            color: #ffffff;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            font-size: 15px;
            font-family: inherit;
            cursor: pointer;
            padding: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            line-height: 1.3;
            transition: all 0.2s ease;
        }

        .card-button:hover {
            background-color: #334155;
            color: #ffffff;
        }

        .card-outlined {
            background: #ffffff;
            border: 2px solid #0080ff;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 25px;
            min-height: 180px;
        }

        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; margin-bottom: 5px; font-size: 14px; font-weight: 600; }
        .form-group input, .form-group select { width: 100%; padding: 8px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px; }

        .btn-dark-red {
            background-color: #a00000;
            color: white;
            border: none;
            padding: 10px;
            border-radius: 8px;
            font-weight: bold;
            font-size: 13px;
            cursor: pointer;
        }

        .btn-green {
            background-color: #16a34a;
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 6px;
            font-weight: bold;
            font-size: 12px;
            cursor: pointer;
        }

        .btn-blue {
            background-color: #0080ff;
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 6px;
            font-weight: bold;
            font-size: 12px;
            cursor: pointer;
        }

        .btn-red-outline {
            background-color: transparent;
            color: #dc2626;
            border: 1px solid #dc2626;
            padding: 6px 12px;
            border-radius: 6px;
            font-weight: bold;
            font-size: 12px;
            cursor: pointer;
        }

        .btn-gray-outline {
            background-color: transparent;
            color: #64748b;
            border: 1px solid #cbd5e1;
            padding: 6px 12px;
            border-radius: 6px;
            font-weight: bold;
            font-size: 12px;
            cursor: pointer;
        }

        .proposed-card {
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 15px;
            background: #f8fafc;
        }

        .option-chip {
            display: inline-block;
            background: #e2e8f0;
            padding: 6px 12px;
            border-radius: 16px;
            font-size: 13px;
            margin: 4px;
            cursor: pointer;
            border: 1px solid #cbd5e1;
        }

        .option-chip.selected {
            background: #0080ff;
            color: white;
            border-color: #0080ff;
        }

        .reschedule-panel {
            display: none;
            margin-top: 12px;
            padding: 12px;
            background: #f1f5f9;
            border-radius: 6px;
            border: 1px solid #cbd5e1;
        }

        .hours-badge {
            background-color: #0284c7;
            color: white;
            padding: 15px 25px;
            border-radius: 8px;
            margin-bottom: 20px;
            display: inline-block;
        }
        
        table.log-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }
        table.log-table th, table.log-table td {
            border: 1px solid #cbd5e1;
            padding: 10px;
            text-align: left;
        }
        table.log-table th {
            background-color: #f1f5f9;
        }
    </style>
</head>
<body>

    <div class="sidebar">
        <div class="sidebar-brand">JCHS Mu Alpha Theta</div>
        <ul class="sidebar-menu">
            <li class="sidebar-item"><a class="sidebar-link active" onclick="switchTab('dashboard-tab', this)">Dashboard</a></li>
            <li class="sidebar-item"><a class="sidebar-link" onclick="switchTab('schedule-tab', this)">Schedule Session</a></li>
            <li class="sidebar-item"><a class="sidebar-link" onclick="switchTab('proposed-tab', this); loadProposedSessions();">Proposed Sessions</a></li>
            <li class="sidebar-item"><a class="sidebar-link" onclick="switchTab('upcoming-tab', this); loadUpcomingSessions();">Upcoming Sessions</a></li>
            <li class="sidebar-item"><a class="sidebar-link" onclick="switchTab('past-sessions-tab', this); loadPastSessions();">Past Sessions</a></li>

            <% if (user.role === 'tutor') { %>
                <li class="sidebar-item"><a class="sidebar-link" onclick="switchTab('volunteer-hours-tab', this); loadVolunteerHours();">Volunteer Hours</a></li>
            <% } %>

            <li class="sidebar-item"><a class="sidebar-link" onclick="switchTab('resources-tab', this)">Resources</a></li>
            <li class="sidebar-item"><a class="sidebar-link" onclick="switchTab('competitions-tab', this)">Competitions</a></li>
            <li class="sidebar-item"><a class="sidebar-link" onclick="switchTab('settings-tab', this)">Profile Settings</a></li>
        </ul>
        <div class="sidebar-footer">
            Logged in as:<br>
            <strong><%= user.username %></strong>
            <br><br>
            <a href="/logout" style="color: #f87171; text-decoration: none;">Logout</a>
        </div>
    </div>

    <div class="main-wrapper">
        <div class="navbar">
            <div class="user-badge">
                <%= user.username %> | <%= user.role.toUpperCase() %>
            </div>
        </div>

        <div id="dashboard-tab" class="tab-content active">
            <h1 class="welcome-title">Hi <%= user.username %>,</h1>

            <div class="square-cards-container">
                <div class="card-square">
                    <button class="card-button" style="background-color: #550000;" onclick="switchTab('proposed-tab', null); loadProposedSessions();">
                        View proposed sessions
                    </button>
                </div>

                <div class="card-square">
                    <button class="card-button" style="background-color: #550000;" onclick="switchTab('upcoming-tab', null); loadUpcomingSessions();">
                        View upcoming sessions
                    </button>
                </div>

                <div class="card-square">
                    <button class="card-button" style="background-color: #550000;" onclick="switchTab('past-sessions-tab', null); loadPastSessions();">
                        Past Sessions
                    </button>
                </div>

                <% if (user.role === 'tutor') { %>
                    <div class="card-square">
                        <button class="card-button" style="background-color: #550000;" onclick="switchTab('volunteer-hours-tab', null); loadVolunteerHours();">
                            Volunteer Hours
                        </button>
                    </div>
                <% } %>

                <div class="card-square">
                    <button class="card-button" style="background-color: #550000;" onclick="switchTab('schedule-tab', null)">
                        Schedule Sessions
                    </button>
                </div>

                <div class="card-square">
                    <button class="card-button" style="background-color: #550000;" onclick="switchTab('settings-tab', null)">
                        Settings
                    </button>
                </div>
            </div>
        </div>

        <div id="schedule-tab" class="tab-content">
            <div class="card-outlined" style="max-width: 700px; margin: 0 auto;">
                
                <div id="schedule-step-1">
                    <h3>Step 1: Select Subject</h3>
                    <p id="step-1-label" style="text-align: center; font-weight: 500;">
                        <%= user.role === 'tutor' ? 'What course are you helping out in?' : 'What course do you need help in?' %>
                    </p>
                    
                    <div style="display: flex; gap: 15px; justify-content: center; margin-top: 20px;">
                        <select id="courseSelect" style="padding: 10px; font-size: 16px; border-radius: 6px; border: 1px solid #cbd5e1; width: 60%;">
                            <option value="Algebra">Algebra</option>
                            <option value="Algebra H">Algebra H</option>
                            <option value="Advanced Algebra">Advanced Algebra</option>
                            <option value="Precalculus">Precalculus</option>
                            <option value="AP Precalculus">AP Precalculus</option>
                            <option value="AP Calculus AB">AP Calculus AB</option>
                            <option value="AP Calculus BC">AP Calculus BC</option>
                            <option value="AP Statistics">AP Statistics</option>
                            <option value="AMDM">AMDM</option>
                        </select>
                        <button class="btn-dark-red" onclick="goToStep2()" style="flex: 0 0 auto; padding: 10px 20px;">Next &rarr;</button>
                    </div>
                </div>

                <div id="schedule-step-2" style="display: none;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                        <button onclick="goToStep1()" style="background: none; border: none; color: #0080ff; cursor: pointer; font-weight: bold;">&larr; Back to Step 1</button>
                        <h3 style="margin: 0;">Step 2: Select <%= user.role === 'tutor' ? 'Tutee' : 'Tutor' %></h3>
                        <div></div>
                    </div>

                    <p style="text-align: center; color: #64748b;">
                        Showing matches for <strong id="selected-course-tag"></strong>:
                    </p>

                    <div id="peer-board" style="display: flex; flex-direction: column; gap: 12px; margin-top: 20px;"></div>
                </div>

                <div id="schedule-step-3" style="display: none;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                        <button onclick="goToStep2()" style="background: none; border: none; color: #0080ff; cursor: pointer; font-weight: bold;">&larr; Back to Step 2</button>
                        <h3 style="margin: 0;">Step 3: Propose Session Details</h3>
                        <div></div>
                    </div>

                    <p style="text-align: center; color: #64748b;">
                        Proposing session with <strong id="selected-peer-name"></strong> for <strong id="selected-peer-course"></strong>
                    </p>

                    <form id="proposeSessionForm" onsubmit="submitProposedSession(event)" style="margin-top: 20px;">
                        <div class="form-group">
                            <label>Session Duration:</label>
                            <select id="sessionDuration" required>
                                <option value="0.5">0.5 Hours (30 mins)</option>
                                <option value="1.0" selected>1.0 Hour (60 mins)</option>
                                <option value="1.5">1.5 Hours (90 mins)</option>
                                <option value="2.0">2.0 Hours (120 mins)</option>
                                <option value="2.5">2.5 Hours</option>
                                <option value="3.0">3.0 Hours</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Option 1 (Required):</label>
                            <input type="datetime-local" id="timeOption1" required>
                        </div>
                        <div class="form-group">
                            <label>Option 2 (Optional):</label>
                            <input type="datetime-local" id="timeOption2">
                        </div>
                        <div class="form-group">
                            <label>Option 3 (Optional):</label>
                            <input type="datetime-local" id="timeOption3">
                        </div>
                        <div class="form-group">
                            <label>Preferred Location / Note:</label>
                            <input type="text" id="sessionLocation" placeholder="e.g., Media Center / Room 214" required>
                        </div>

                        <div style="text-align: right; margin-top: 20px;">
                            <button type="submit" class="btn-dark-red" style="padding: 10px 25px;">Propose Session</button>
                        </div>
                    </form>
                </div>

            </div>
        </div>

        <div id="proposed-tab" class="tab-content">
            <div class="card-outlined">
                <h3>Proposed Sessions</h3>
                <div id="proposed-sessions-list">
                    <p style="color: #64748b;">No proposed sessions at this time.</p>
                </div>
            </div>
        </div>

        <div id="upcoming-tab" class="tab-content">
            <div class="card-outlined">
                <h3>Upcoming Sessions</h3>
                <div id="upcoming-sessions-list">
                    <p style="color: #64748b;">No upcoming sessions scheduled.</p>
                </div>
            </div>
        </div>

        <div id="past-sessions-tab" class="tab-content">
            <div class="card-outlined">
                <h3>Past Sessions</h3>
                <p style="color: #64748b; font-size: 14px;">History of all your completed tutoring sessions.</p>
                <div id="past-sessions-container">
                    <p style="color: #64748b;">Loading past sessions...</p>
                </div>
            </div>
        </div>

        <% if (user.role === 'tutor') { %>
            <div id="volunteer-hours-tab" class="tab-content">
                <div class="card-outlined">
                    <h3>Volunteer Hours</h3>
                    <div class="hours-badge">
                        <div style="font-size: 14px; opacity: 0.9;">Total Logged Volunteer Hours</div>
                        <div id="total-volunteer-hours" style="font-size: 32px; font-weight: bold;">0.0 hrs</div>
                    </div>

                    <h4>Completed Hours Log</h4>
                    <div id="volunteer-log-container">
                        <p style="color: #64748b;">Loading hours log...</p>
                    </div>
                </div>
            </div>
        <% } %>

        <div id="resources-tab" class="tab-content">
            <div class="card-outlined">
                <h3>Math Learning Resources</h3>
                <ul>
                    <li><a href="#">Algebra Practice Worksheets</a></li>
                    <li><a href="#">AP Calculus Formula Sheets</a></li>
                    <li><a href="#">Peer Tutoring Guidelines</a></li>
                </ul>
            </div>
        </div>

        <div id="competitions-tab" class="tab-content">
            <div class="card-outlined">
                <h3>Competitions</h3>
                <p style="color: #64748b;">No upcoming competitions posted yet.</p>
            </div>
        </div>

        <div id="settings-tab" class="tab-content">
            <div class="card-outlined">
                <h3>Profile Settings</h3>
                <p><strong>Name:</strong> <%= user.username %></p>
                <p><strong>Role:</strong> <%= user.role %></p>
                <p><strong>Primary Subject:</strong> <%= user.subject %></p>
            </div>
        </div>
    </div>

    <script>
        const CURRENT_USER_ID = "<%= user.id %>";
        const CURRENT_USER_ROLE = "<%= user.role %>";

        let selectedSubject = '';
        let selectedPeer = null;

        function switchTab(tabId, element) {
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
            document.querySelectorAll('.sidebar-link').forEach(link => link.classList.remove('active'));
            
            const targetTab = document.getElementById(tabId);
            if (targetTab) targetTab.classList.add('active');
            if (element) element.classList.add('active');
        }

        function goToStep1() {
            document.getElementById('schedule-step-1').style.display = 'block';
            document.getElementById('schedule-step-2').style.display = 'none';
            document.getElementById('schedule-step-3').style.display = 'none';
        }

        async function goToStep2() {
            selectedSubject = document.getElementById('courseSelect').value;
            if (!selectedSubject) {
                alert('Please select a course first!');
                return;
            }

            document.getElementById('selected-course-tag').innerText = selectedSubject;
            document.getElementById('schedule-step-1').style.display = 'none';
            document.getElementById('schedule-step-2').style.display = 'block';
            document.getElementById('schedule-step-3').style.display = 'none';

            let peerRole = (CURRENT_USER_ROLE === "tutor") ? "tutee" : "tutor";

            try {
                const response = await fetch(`/available-peers?subject=${encodeURIComponent(selectedSubject)}&role=${peerRole}`);
                if (!response.ok) return alert(`Error fetching peers: ${response.status}`);

                const peers = await response.json();
                const board = document.getElementById('peer-board');
                board.innerHTML = '';

                if (!peers || peers.length === 0) {
                    board.innerHTML = `<p style="text-align: center; color: #94a3b8; padding: 20px;">No available ${peerRole}s found for ${selectedSubject}.</p>`;
                    return;
                }

                peers.forEach(peer => {
                    const card = document.createElement('div');
                    card.style.cssText = 'display: flex; justify-content: space-between; align-items: center; padding: 15px; border: 1px solid #e2e8f0; border-radius: 8px; background: #f8fafc;';
                    
                    card.innerHTML = `
                        <div>
                            <strong style="font-size: 16px; color: #0f172a;">${peer.username}</strong>
                            <span style="font-size: 13px; color: #64748b; margin-left: 8px;">(Grade ${peer.grade || 'N/A'})</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 15px;">
                            <span style="background: #e2e8f0; padding: 4px 10px; border-radius: 12px; font-size: 13px; font-weight: 600; color: #334155;">
                                ${peer.subject}
                            </span>
                            <button class="btn-dark-red" onclick="goToStep3('${peer.id}', '${peer.username}')">
                                Select Peer &rarr;
                            </button>
                        </div>
                    `;
                    board.appendChild(card);
                });
            } catch (err) {
                console.error('Fetch error:', err);
                alert('Failed to connect to the server.');
            }
        }

        function goToStep3(peerId, peerUsername) {
            selectedPeer = { id: peerId, username: peerUsername };
            document.getElementById('selected-peer-name').innerText = peerUsername;
            document.getElementById('selected-peer-course').innerText = selectedSubject;

            document.getElementById('schedule-step-1').style.display = 'none';
            document.getElementById('schedule-step-2').style.display = 'none';
            document.getElementById('schedule-step-3').style.display = 'block';
        }

        async function submitProposedSession(event) {
            event.preventDefault();

            const duration = document.getElementById('sessionDuration').value;
            const opt1 = document.getElementById('timeOption1').value;
            const opt2 = document.getElementById('timeOption2').value;
            const opt3 = document.getElementById('timeOption3').value;
            const location = document.getElementById('sessionLocation').value;

            const timeOptions = [opt1, opt2, opt3].filter(Boolean);

            const payload = {
                requesterId: CURRENT_USER_ID,
                targetId: selectedPeer ? selectedPeer.id : null,
                requesterRole: CURRENT_USER_ROLE,
                subject: selectedSubject,
                durationHours: parseFloat(duration) || 1.0,
                location: location,
                proposedTimes: timeOptions
            };

            try {
                const response = await fetch('/api/schedule-session', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json().catch(() => ({}));

                if (response.ok) {
                    alert('Session proposed successfully!');
                    goToStep1();
                    switchTab('proposed-tab', null);
                    loadProposedSessions();
                } else {
                    alert(`Failed to propose session: ${result.error || result.message || response.statusText}`);
                }
            } catch (err) {
                console.error('Submission network error:', err);
                alert('An error occurred while connecting to the server.');
            }
        }

        async function loadProposedSessions() {
            try {
                const response = await fetch(`/api/proposed-sessions?userId=${CURRENT_USER_ID}`);
                if (!response.ok) return;

                const proposals = await response.json();
                const container = document.getElementById('proposed-sessions-list');

                if (!proposals || proposals.length === 0) {
                    container.innerHTML = `<p style="color: #64748b;">No proposed sessions at this time.</p>`;
                    return;
                }

                container.innerHTML = proposals.map(prop => {
                    const peerName = (CURRENT_USER_ROLE === 'tutor') 
                        ? (prop.tutee?.username || 'Tutee') 
                        : (prop.tutor?.username || 'Tutor');
                    
                    const isRequester = String(prop.requester_id) === String(CURRENT_USER_ID);

                    return `
                        <div class="proposed-card" id="proposal-${prop.id}">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                <div>
                                    <h4 style="margin: 0 0 5px 0;">${prop.subject} Session (${prop.duration_hours || 1.0} hrs)</h4>
                                    <p style="margin: 0; font-size: 14px; color: #475569;">
                                        <strong>With:</strong> ${peerName} | <strong>Location:</strong> ${prop.location}
                                    </p>
                                </div>
                                <div>
                                    ${isRequester ? `
                                        <span style="font-size: 12px; font-weight: 600; color: #d97706; background: #fef3c7; padding: 4px 10px; border-radius: 12px;">
                                            Pending peer response...
                                        </span>
                                    ` : `
                                        <button class="btn-green" onclick="acceptProposal('${prop.id}', event)">Accept Slot</button>
                                        <button class="btn-red-outline" onclick="rejectProposal('${prop.id}')">Reject</button>
                                    `}
                                </div>
                            </div>
                            
                            <div style="margin-top: 12px;">
                                <span style="font-size: 13px; font-weight: 600;">Proposed Time Options:</span><br>
                                ${(prop.proposed_times || []).map((time, idx) => `
                                    <div class="option-chip ${idx === 0 ? 'selected' : ''}" onclick="selectOptionChip(this)" data-time="${time}">
                                        ${new Date(time).toLocaleString([], { dateStyle: 'short', timeStyle: 'short' })}
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                    `;
                }).join('');
            } catch (err) {
                console.error('Error loading proposals:', err);
            }
        }

        async function loadUpcomingSessions() {
            try {
                const response = await fetch(`/api/upcoming-sessions?userId=${CURRENT_USER_ID}`);
                if (!response.ok) return;

                const sessions = await response.json();
                const container = document.getElementById('upcoming-sessions-list');

                if (!sessions || sessions.length === 0) {
                    container.innerHTML = `<p style="color: #64748b;">No upcoming sessions scheduled.</p>`;
                    return;
                }

                container.innerHTML = sessions.map(s => {
                    const peerName = (CURRENT_USER_ROLE === 'tutor') ? s.tutee?.username : s.tutor?.username;
                    const formattedTime = new Date(s.scheduled_time).toLocaleString([], { dateStyle: 'short', timeStyle: 'short' });

                    return `
                        <div class="proposed-card" id="session-card-${s.id}">
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 10px;">
                                <div>
                                    <strong style="font-size: 16px;">${s.subject} Session</strong> with ${peerName || 'Peer'}
                                    <div style="font-size: 13px; color: #475569; margin-top: 4px;">
                                        <strong>Location:</strong> ${s.location} | <strong>Time:</strong> ${formattedTime} | <strong>Duration:</strong> ${s.duration_hours || 1.0} hr(s)
                                    </div>
                                </div>
                                <div style="display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end;">
                                    <button class="btn-green" onclick="markCompleted('${s.id}')">Mark Complete</button>
                                    <button class="btn-blue" onclick="toggleRescheduleForm('${s.id}')">Reschedule</button>
                                    <button class="btn-red-outline" onclick="cancelSession('${s.id}')">Cancel</button>
                                </div>
                            </div>

                            <div class="reschedule-panel" id="reschedule-panel-${s.id}">
                                <label style="font-size: 12px; font-weight: bold; display: block; margin-bottom: 5px;">Select New Date & Time:</label>
                                <div style="display: flex; gap: 8px;">
                                    <input type="datetime-local" id="reschedule-input-${s.id}" style="padding: 6px; border-radius: 4px; border: 1px solid #cbd5e1; flex-grow: 1;">
                                    <button class="btn-green" onclick="submitReschedule('${s.id}')">Save</button>
                                    <button class="btn-gray-outline" onclick="toggleRescheduleForm('${s.id}')">Close</button>
                                </div>
                            </div>
                        </div>
                    `;
                }).join('');
            } catch (err) {
                console.error('Error loading upcoming sessions:', err);
            }
        }

        async function loadPastSessions() {
            try {
                const response = await fetch(`/api/past-sessions?userId=${CURRENT_USER_ID}`);
                if (!response.ok) return;

                const sessions = await response.json();
                const container = document.getElementById('past-sessions-container');

                if (!sessions || sessions.length === 0) {
                    container.innerHTML = `<p style="color: #64748b;">No completed sessions found.</p>`;
                    return;
                }

                container.innerHTML = `
                    <table class="log-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Subject</th>
                                <th>${CURRENT_USER_ROLE === 'tutor' ? 'Tutee' : 'Tutor'}</th>
                                <th>Location</th>
                                <th>Duration</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${sessions.map(s => {
                                const peerName = (CURRENT_USER_ROLE === 'tutor') 
                                    ? (s.tutee?.username || 'N/A') 
                                    : (s.tutor?.username || 'N/A');
                                
                                return `
                                    <tr>
                                        <td>${new Date(s.scheduled_time || s.created_at).toLocaleDateString()}</td>
                                        <td>${s.subject}</td>
                                        <td>${peerName}</td>
                                        <td>${s.location || 'N/A'}</td>
                                        <td>${s.duration_hours || 1.0} hr(s)</td>
                                    </tr>
                                `;
                            }).join('')}
                        </tbody>
                    </table>
                `;
            } catch (err) {
                console.error('Error loading past sessions:', err);
            }
        }

        async function loadVolunteerHours() {
            if (CURRENT_USER_ROLE !== 'tutor') return;

            try {
                const response = await fetch(`/api/volunteer-hours?userId=${CURRENT_USER_ID}`);
                if (!response.ok) return;

                const data = await response.json();
                const container = document.getElementById('volunteer-log-container');
                
                document.getElementById('total-volunteer-hours').innerText = `${data.totalHours || 0.0} hrs`;

                if (!data.sessions || data.sessions.length === 0) {
                    container.innerHTML = `<p style="color: #64748b;">No completed tutoring sessions to calculate hours.</p>`;
                    return;
                }

                container.innerHTML = `
                    <table class="log-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Subject</th>
                                <th>Tutee</th>
                                <th>Logged Duration</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${data.sessions.map(s => `
                                <tr>
                                    <td>${new Date(s.scheduled_time || s.created_at).toLocaleDateString()}</td>
                                    <td>${s.subject}</td>
                                    <td>${s.tutee?.username || 'N/A'}</td>
                                    <td><strong>+${s.duration_hours || 1.0} hr(s)</strong></td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>
                `;
            } catch (err) {
                console.error('Error loading volunteer hours:', err);
            }
        }

        function toggleRescheduleForm(sessionId) {
            const panel = document.getElementById(`reschedule-panel-${sessionId}`);
            if (panel) {
                panel.style.display = (panel.style.display === 'block') ? 'none' : 'block';
            }
        }

        async function markCompleted(sessionId) {
            if (!confirm('Mark this session as complete? It will move to Past Sessions and log volunteer hours (if tutor).')) return;

            try {
                const response = await fetch('/api/sessions/complete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ sessionId, userId: CURRENT_USER_ID })
                });

                if (response.ok) {
                    alert('Session completed!');
                    loadUpcomingSessions();
                } else {
                    alert('Failed to mark session as completed.');
                }
            } catch (err) {
                console.error('Error completing session:', err);
            }
        }

        async function cancelSession(sessionId) {
            if (!confirm('Are you sure you want to cancel this session?')) return;

            try {
                const response = await fetch('/api/sessions/cancel', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ sessionId, userId: CURRENT_USER_ID })
                });

                if (response.ok) {
                    alert('Session canceled.');
                    loadUpcomingSessions();
                } else {
                    alert('Failed to cancel session.');
                }
            } catch (err) {
                console.error('Error canceling session:', err);
            }
        }

        async function submitReschedule(sessionId) {
            const newTime = document.getElementById(`reschedule-input-${sessionId}`).value;

            if (!newTime) {
                alert('Please select a new date and time.');
                return;
            }

            try {
                const response = await fetch('/api/sessions/reschedule', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ sessionId, newTime, userId: CURRENT_USER_ID })
                });

                if (response.ok) {
                    alert('Session rescheduled successfully!');
                    loadUpcomingSessions();
                } else {
                    alert('Failed to reschedule session.');
                }
            } catch (err) {
                console.error('Error rescheduling session:', err);
            }
        }

        function selectOptionChip(chip) {
            const parent = chip.parentElement;
            parent.querySelectorAll('.option-chip').forEach(c => c.classList.remove('selected'));
            chip.classList.add('selected');
        }

        async function acceptProposal(proposalId, evt) {
            const card = evt.target.closest('.proposed-card');
            const selectedChip = card.querySelector('.option-chip.selected');
            const selectedTime = selectedChip ? selectedChip.getAttribute('data-time') : null;

            if (!selectedTime) {
                alert('Please select a time slot first.');
                return;
            }

            const response = await fetch('/api/sessions/accept', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ proposalId, selectedTime })
            });

            if (response.ok) {
                alert('Proposal accepted!');
                loadProposedSessions();
            } else {
                alert('Failed to accept proposal.');
            }
        }

        async function rejectProposal(proposalId) {
            const response = await fetch('/api/sessions/reject', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ proposalId })
            });

            if (response.ok) {
                alert('Proposal rejected.');
                loadProposedSessions();
            } else {
                alert('Failed to reject proposal.');
            }
        }
    </script>
</body>
</html>